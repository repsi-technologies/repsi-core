ENVIRONMENT=development
DEBUG=true
API_PORT=8000

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://repsi:repsi@localhost:5432/repsi
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── API Security & JWT Authentication ──────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_SECRET=change-me-in-production-use-another-long-random-string
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://repsi.app"]

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply.repsi@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=noreply.repsi@gmail.com
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# WhatsApp OTP: use "aisensy" in production and provide the credentials below.
OTP_PROVIDER=test
ALLOW_TEST_OTP_IN_PRODUCTION=false
AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=

# ─── Cashfree Payment Gateway & SaaS Billing ────────────────────────────────
# Get App ID and Secret Key from Cashfree Merchant Dashboard > Developers > API Keys
# For production server: use PROD credentials; for testing/staging: use TEST credentials
CASHFREE_APP_ID=cf_app_id_from_cashfree_dashboard
CASHFREE_SECRET_KEY=cf_secret_key_from_cashfree_dashboard
# Environment: PROD (production) or TEST (sandbox)
CASHFREE_ENV=PROD
CASHFREE_API_VERSION=2026-01-01

# Central SaaS billing (repsi.app/pay). Set to false initially during deploy; set to true when ready
SAAS_BILLING_ENABLED=false
# Public HTTPS API base URL for Cashfree notify_url webhooks (must start with https:// in production)
# Example: https://api.repsi.app (webhook will hit https://api.repsi.app/api/v1/saas-billing/webhooks/cashfree)
SAAS_PUBLIC_API_URL=https://api.repsi.app
# Where the central web checkout page lives (e.g. https://repsi.app/pay)
SAAS_CHECKOUT_URL=https://repsi.app/pay
# Order expiration time in minutes
SAAS_ORDER_TTL_MINUTES=30
# Grace period in days after missed renewal before read-only lock
SAAS_GRACE_DAYS=7
# Trial duration in days for new workspaces
SAAS_TRIAL_DAYS=14
# Handoff token TTL in seconds for seamless checkout redirect from app
SAAS_HANDOFF_TTL_SECONDS=300
# Alerts for stuck orders, payment mismatches, failed webhooks (empty = log only)
SAAS_ALERT_EMAIL=ops@repsi.app

# ─── Google OAuth Server Verification ────────────────────────────────────────
# Required in production for Google sign-in. Must match web NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated extra OAuth client IDs for mobile apps (Android/iOS)
GOOGLE_MOBILE_CLIENT_IDS=

# AI (Google Gemini). Leave GEMINI_API_KEY empty to run every AI feature in standard (no-AI) mode.
# Free-tier keys: Google may use prompts to improve its products; REPSI only sends aggregates, never member details.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Keep these under your key's free-tier limits (see AI Studio > Rate limits)
AI_GLOBAL_DAILY_CALLS=800
AI_GLOBAL_CALLS_PER_MINUTE=10
AI_MEMBER_DAILY_CALLS=5
AI_STAFF_DAILY_CALLS=20

# ─── Public images (gym logos, profile photos) ──────────────────────────────
# Leave empty to keep images in file storage. Private documents and receipts never go to Cloudinary.
# Find it in the Cloudinary console: Settings > API Keys > "API environment variable".
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@dvmflskfx
CLOUDINARY_FOLDER=repsi

# ─── Sales demo gym (python -m scripts.seed_demo) ───────────────────────────
# Isolated demo workspace with sample data; outbound messages and account/billing changes are blocked.
DEMO_ACCOUNT_EMAIL=demo@repsi.app
DEMO_ACCOUNT_PASSWORD=
DEMO_WORKSPACE_SLUG=repsi-demo
